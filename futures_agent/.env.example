# Chaves de API da Binance Futures (USDⓈ-M)
# Apenas para execução de ordens reais em modo Live. O modo Paper e o Scanner funcionam sem chave.
BINANCE_API_KEY=""
BINANCE_SECRET_KEY=""

# Modo de Operação
# paper = Modo simulado em papel (padrão seguro)
# live  = Modo real (exige flag --live e confirmação 'CONFIRMAR' no terminal)
TRADING_MODE="paper"

# Configuração do Ollama Local
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Parâmetros Estratégicos Padrão
DEFAULT_RSI_PERIOD=14
DEFAULT_RSI_OVERSOLD=30.0
DEFAULT_RSI_OVERBOUGHT=70.0
DEFAULT_VOLUME_RATIO=2.0
DEFAULT_TIMEFRAME="15m"
